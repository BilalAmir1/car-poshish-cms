{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "singularName": "gallery-item",
    "pluralName": "gallery-items",
    "displayName": "Gallery Item",
    "description": "Before/after work examples shown on the Our Work page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "carModel": {
      "type": "string",
      "required": true
    },
    "serviceLabel": {
      "type": "string",
      "required": true,
      "description": "e.g. \"Full exterior detailing\""
    },
    "beforeImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "afterImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
