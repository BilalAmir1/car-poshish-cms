{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Shop product orders — cash on delivery or in-shop pickup, no online payment"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "items": {
      "type": "json",
      "required": true,
      "description": "Snapshot of cart items at order time: [{ name, price, quantity }]"
    },
    "subtotal": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "fulfillmentMethod": {
      "type": "enumeration",
      "enum": ["pickup", "delivery"],
      "required": true
    },
    "deliveryZone": {
      "type": "string",
      "description": "Only set when fulfillmentMethod is delivery"
    },
    "deliveryFee": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "total": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "customerPhone": {
      "type": "string",
      "required": true
    },
    "deliveryAddress": {
      "type": "text",
      "description": "Required only when fulfillmentMethod is delivery — validated in the Next.js API route, not enforced here since it doesn't apply to pickup orders"
    },
    "deliveryCity": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "paymentMethod": {
      "type": "string",
      "default": "Cash on delivery / pickup"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "ready", "out_for_delivery", "completed", "cancelled"],
      "default": "pending"
    }
  }
}
