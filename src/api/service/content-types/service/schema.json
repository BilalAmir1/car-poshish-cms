{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Car detailing services offered at the shop"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "icon": {
      "type": "enumeration",
      "enum": ["droplet", "cloth", "sparkle", "wrench", "bulb", "shield", "tyre", "spray", "seat"],
      "default": "sparkle"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show on the homepage teaser (top 3, by order)"
    }
  }
}
